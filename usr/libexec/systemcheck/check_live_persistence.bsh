## AI-Assisted

## Globals are set and consumed by 'systemcheck'.
# shellcheck disable=SC2154,SC2034

## style-ok: no-strict
## Sourced fragment; 'systemcheck' owns the strict-mode preamble.

## Sets live_status_persistence_requested + live_status_persistence_active.
# shellcheck source=../../../../helper-scripts/usr/libexec/helper-scripts/live-mode.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/live-mode.sh

## Run at graphical login too: a user who booted the 'Persistent' entry but ended
## up amnesic must be told BEFORE they trust the session with data.
systemcheck_autostart_functions+=" check_live_persistence "

## Warn when a persistent-live GRUB entry was booted
## (rd.live.overlay=LABEL=persistence:/live/overlay) but no persistence volume
## actually engaged, so the system is SILENTLY running amnesic (all changes lost on
## reboot). dmsquash-live gives no error for this -- only a brief initramfs notice.
check_live_persistence() {
  local status_text MSG MSG_CLI
  status_text="Live Persistence"

  if [ -f '/usr/share/qubes/marker-vm' ]; then
    return 0
  fi

  ## Not a persistent-live boot: nothing to warn about (amnesic live and installed
  ## systems are expected states handled elsewhere).
  if [ "${live_status_persistence_requested}" != 'true' ]; then
    return 0
  fi

  if [ "${live_status_persistence_active}" = 'true' ]; then
    local MSG_OK="<p>${status_text}: persistent overlay active, ${status_ok}</p>"
    run_if_verbose emit_message info "${MSG_OK}"
    return 0
  fi

  MSG="<p>${status_text}: <font color=\"red\">running amnesic</font></p>
<p>You booted a <b>Persistent</b> entry, but no persistence volume was found, so this
session is running <b>amnesic</b>: <u>all changes will be lost on reboot</u>.</p>
<p>Most likely the persistence disk is missing, or it has not been provisioned yet.
In a live session, provision a second disk with <code>sudo persistence-setup</code>,
then reboot into the <b>Persistent</b> submenu. If the disk is LUKS-encrypted, enter
its passphrase when prompted in early boot.</p>"
  ${output_x} "${output_opts[@]}" --messagex --typex "warning" --message "${MSG}"

  MSG_CLI="${status_text}: running amnesic.
You booted a 'Persistent' entry, but no persistence volume was found, so this session
is running amnesic: all changes will be lost on reboot. Provision a second disk in a
live session with 'sudo persistence-setup', then reboot into the 'Persistent' submenu."
  ${output_cli} "${output_opts[@]}" --messagecli --typecli "warning" --message "${MSG_CLI}"

  EXIT_CODE="1"

  if_you_know_what_you_are_doing_funct "${FUNCNAME[0]}"
}
