#!/bin/bash

## Copyright (C) 2012 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## Globals are set by 'systemcheck'.
# shellcheck disable=SC2154

## style-ok: no-strict
## Sourced fragment; 'systemcheck' owns the strict-mode preamble.

## Grave boot-role mismatch: surfaced even in autostart mode (like
## check_unrestricted_mode_in_template), not just on a manual run.
## NOTE: the orchestrator's autostart/skip gate is an UNANCHORED substring match
## (preparation.bsh: 'case ${systemcheck_autostart_functions} in *"$@"*'), so
## this name must NOT contain another check's name as a substring (e.g. not
## 'check_user_sysmaint_split...', which would also match the aggregator
## 'check_user_sysmaint_split' and drag it into autostart / --skip).
systemcheck_autostart_functions+=" check_sysmaint_boot_role_mismatch "

check_user_sysmaint_split() {
   check_user_sysmaint_split_package
   check_user_sysmaint_split_boot_mode
}

check_user_sysmaint_split_package() {
   local link_sysmaint status_text
   link_sysmaint="https://www.kicksecure.com/wiki/sysmaint"
   status_text="user-sysmaint-split installation check"

   if ! leaprun user-sysmaint-split-check &>/dev/null ; then
      emit_status_line info "${status_text}" "${link_sysmaint}" orange "Not installed"
      return 0
   fi

   emit_status_line info "${status_text}" "${link_sysmaint}" green "Installed"
   return 0
}

check_user_sysmaint_split_boot_mode() {
   ## Factual result line, by the REQUESTED boot role (the SYSMAINT/USER Session
   ## labels are the boot-menu names). A role vs account MISMATCH is NOT
   ## reported here (that would duplicate the grave popup at info severity);
   ## check_sysmaint_boot_role_mismatch owns it.
   if [ "${booted_in_sysmaint_session}" = 'true' ]; then
      MSG="<p>user-sysmaint-split session detection result: SYSMAINT Session.</p>"
   else
      MSG="<p>user-sysmaint-split session detection result: USER Session.</p>"
   fi

   emit_message info "${MSG}"
}

check_sysmaint_boot_role_mismatch() {
   ## Grave, easy-to-miss states where the account the session landed on does
   ## not match the session type requested at boot (kernel 'boot-role=sysmaint'):
   ##  - SYSMAINT requested, landed unprivileged: user expects sudo for
   ##    maintenance, but root tasks silently fail.
   ##  - USER requested, landed on 'sysmaint': user expects a locked-down
   ##    session, but actually holds sudo-capable privileges.
   local gui_msg cli_msg link_sysmaint
   link_sysmaint="https://www.kicksecure.com/wiki/sysmaint"

   ## The user/sysmaint privilege split only exists when user-sysmaint-split is
   ## installed. Without it there is no 'sysmaint' account to land on and a
   ## 'boot-role=sysmaint' cmdline (e.g. unrestricted-admin transitional state)
   ## does NOT imply the current account lacks sudo, so a "sudo will not work"
   ## claim would be false. check_unrestricted_mode_in_template owns that case.
   if [ "${user_sysmaint_split_installed}" != 'true' ]; then
      return 0
   fi

   if [ "${booted_in_sysmaint_session}" = 'true' ]; then
      if running_as_sysmaint; then
         return 0
      fi
      gui_msg="<p>You selected <code>SYSMAINT Session</code> at boot, but you are logged in as standard user <code>${who_ami}</code>, not the <code>sysmaint</code> account. Administrative (root / sudo) tasks will NOT work in this session. To perform system maintenance, log out and log back in as the <code>sysmaint</code> user, or reboot and select <code>PERSISTENT Mode | SYSMAINT Session | system maintenance tasks</code>. See <code>${link_sysmaint}</code>.</p>"
      cli_msg="You selected 'SYSMAINT Session' at boot, but you are logged in as standard user '${who_ami}', not the 'sysmaint' account. Administrative (root / sudo) tasks will NOT work in this session. To perform system maintenance, log out and log back in as the 'sysmaint' user, or reboot and select 'PERSISTENT Mode | SYSMAINT Session | system maintenance tasks'. See ${link_sysmaint}"
   else
      if ! running_as_sysmaint; then
         return 0
      fi
      gui_msg="<p>You selected <code>USER Session</code> at boot, but you are logged in as the privileged <code>sysmaint</code> account, which has administrative (root / sudo) capabilities. This is NOT the locked-down session you requested. Log out and log back in as your standard user account, or reboot and select <code>PERSISTENT Mode | USER Session</code>. See <code>${link_sysmaint}</code>.</p>"
      cli_msg="You selected 'USER Session' at boot, but you are logged in as the privileged 'sysmaint' account, which has administrative (root / sudo) capabilities. This is NOT the locked-down session you requested. Log out and log back in as your standard user account, or reboot and select 'PERSISTENT Mode | USER Session'. See ${link_sysmaint}"
   fi

   ${output_x} "${output_opts[@]}" --passivepopupqueuex --passivepopupqueuextitle "${passive_popup_title}" --typex "error" --message "${gui_msg}" --done
   ${output_cli} "${output_opts[@]}" --messagecli --typecli "error" --message "${cli_msg}"
}
