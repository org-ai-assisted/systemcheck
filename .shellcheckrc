## ShellCheck configuration for the systemcheck package.
##
## The check_*.bsh fragments are sourced fragments, not standalone scripts:
## they read globals (verbose, silent, EXIT_CODE, status_ok, TITLE_X, ICON,
## output_x/output_cli, ...) that are only defined once 'systemcheck' sources
## preparation.bsh and every fragment together at runtime. ShellCheck (and the
## style gate, which materializes a staged file in isolation) cannot follow
## that cross-file wiring, so it trips on vars it cannot see.
##
##   SC2154 - vars referenced but not assigned (defined by a sibling fragment).
##   SC2034 - vars assigned but "unused" (read by a sibling fragment).
##   SC1090 - "Can't follow non-constant source" (the *.bsh glob-source loop).
disable=SC2154
disable=SC2034
disable=SC1090

## SC2250 (require-variable-braces, an optional check the style gate enables):
## these fragments follow the upstream unbraced '$var' style throughout, so the
## check would demand restyling entire legacy files for any targeted edit. Off
## repo-wide to match the established style, not applied piecemeal.
disable=SC2250
