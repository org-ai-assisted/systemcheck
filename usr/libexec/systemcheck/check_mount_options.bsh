## Globals are set and consumed by 'systemcheck'.
# shellcheck disable=SC2154,SC2034

## style-ok: no-strict
## Sourced fragment; 'systemcheck' owns the strict-mode preamble.

check_mount_options() {
   local status_text audit_output rc deviation_list_str \
      if_you_know_what_you_are_doing_msg body link level level_status_text \
      level_body

   status_text="Mount Options Hardening Test Result"
   link="https://www.kicksecure.com/wiki/Dev/remount-secure"

   ## Surface the configured remount-secure level (0-3; 3 = most restrictive).
   ## '--get-level' is a read-only, unprivileged query that fails closed to 3.
   ## A level below 3 is a deliberate admin choice, so interactively it is an
   ## orange informational notice, not a hard failure; under '--ci' it is a
   ## hard failure (non-zero exit) so a lowered level cannot ship unnoticed.
   level_status_text="Mount Options Hardening Level"
   level="$(remount-secure --get-level 2>/dev/null)" || level=""
   case "${level}" in
   3)
      run_if_verbose emit_status_line info "${level_status_text}" "${link}" \
         green "Level 3 (most restrictive)"
      ;;
   0|1|2)
      level_body="The configured remount-secure level is ${level}; the most restrictive level is 3. A lower level applies fewer noexec/nosuid/nodev protections to writable mounts.
$(if_you_know_what_you_are_doing_funct "${FUNCNAME[0]}")"
      emit_status_line info "${level_status_text}" "${link}" orange \
         "Level ${level} (below 3)" "${level_body}"
      if [ "${ci:-false}" = "true" ]; then
         EXIT_CODE="1"
      fi
      ;;
   *)
      emit_status_line info "${level_status_text}" "${link}" orange "Indeterminate" \
         "Could not read the configured level via <code>remount-secure --get-level</code>."
      if [ "${ci:-false}" = "true" ]; then
         EXIT_CODE="1"
      fi
      ;;
   esac

   rc=0
   ## Force NEWROOT="" so the audit targets the LIVE root. remount-secure uses
   ## NEWROOT as a sysroot prefix (dracut); an inherited or injected NEWROOT
   ## pointing at a nonexistent root would let every mountpoint read as hardened
   ## -- a fabricated pass. No explicit level: audit against the configured
   ## remount-secure level (drop-in), so a deliberately lowered level is not
   ## reported as a deviation.
   audit_output="$(NEWROOT="" remount-secure --check 2>&1)" || rc=$?

   if [ "${rc}" = "0" ]; then
      run_if_verbose emit_status_line info "${status_text}" "${link}" green "${status_ok}"
      return 0
   fi

   deviation_list_str="$(printf '%s\n' "${audit_output}" | grep '^DEVIATION:' || true)"
   deviation_list_str="$(sanitize-string -- 8192 "${deviation_list_str}")"
   if_you_know_what_you_are_doing_msg="$(if_you_know_what_you_are_doing_funct "${FUNCNAME[0]}")"

   if [ -z "${deviation_list_str}" ]; then
      emit_status_line warning "${status_text}" "${link}" orange "Indeterminate" \
         "Could not verify mount options via <code>remount-secure --check</code> (exit ${rc}).
${if_you_know_what_you_are_doing_msg}"
      EXIT_CODE="1"
      return 0
   fi

   body="One or more mountpoints lack the expected hardening mount options:
${deviation_list_str}
${if_you_know_what_you_are_doing_msg}"
   emit_status_line warning "${status_text}" "${link}" orange "Not hardened" "${body}"
   EXIT_CODE="1"
   return 0
}
