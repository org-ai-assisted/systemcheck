## Globals are set and consumed by 'systemcheck'.
# shellcheck disable=SC2154,SC2034

## style-ok: no-strict
## Sourced fragment; 'systemcheck' owns the strict-mode preamble.

check_mount_options() {
   local status_text audit_output rc deviation_list_str \
      if_you_know_what_you_are_doing_msg body link

   status_text="Mount Options Hardening Test Result"
   link="https://www.kicksecure.com/wiki/Dev/remount-secure"

   rc=0
   audit_output="$(remount-secure --check 3 2>&1)" || rc=$?

   if [ "${rc}" = "0" ]; then
      run_if_verbose emit_status_line info "${status_text}" "${link}" green "${status_ok}"
      return 0
   fi

   deviation_list_str="$(printf '%s\n' "${audit_output}" | grep '^DEVIATION:' || true)"
   deviation_list_str="$(sanitize-string -- 8192 "${deviation_list_str}")"
   if_you_know_what_you_are_doing_msg="$(if_you_know_what_you_are_doing_funct "${FUNCNAME[0]}")"

   if [ -z "${deviation_list_str}" ]; then
      emit_status_line warning "${status_text}" "${link}" orange "Indeterminate" \
         "Could not verify mount options via <code>remount-secure --check</code> (exit ${rc}).
${if_you_know_what_you_are_doing_msg}"
      EXIT_CODE="1"
      return 0
   fi

   body="One or more mountpoints lack the expected hardening mount options:
${deviation_list_str}
${if_you_know_what_you_are_doing_msg}"
   emit_status_line warning "${status_text}" "${link}" orange "Not hardened" "${body}"
   EXIT_CODE="1"
   return 0
}
