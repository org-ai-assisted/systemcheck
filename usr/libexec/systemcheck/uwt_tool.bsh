# shellcheck disable=SC2034  ## vars consumed by the sourcing 'systemcheck' orchestrator

## style-ok: no-strict
## Sourced fragment; 'systemcheck' owns the strict-mode preamble.

## using the non-uwt-wrapped version, if the uwt wrapper is installed,
## which is the case on a default Whonix installation

if has curl.anondist-orig ; then
   CURL=curl.anondist-orig
else
   CURL=curl
fi

if has apt-get.anondist-orig ; then
   APT_GET=apt-get.anondist-orig
else
   APT_GET=apt-get
fi
