## provides was_executed
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/check_runtime.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/check_runtime.bsh || true
if ! declare -F was_executed >/dev/null; then
  printf '%s\n' "$0: ERROR: cannot source check_runtime.bsh!" >&2
  exit 1
fi
## provides has
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/has.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/has.bsh

systemcheck_confine_maybe() {
  ## Re-exec an unconfined run inside a transient 'systemd --user' scope carrying
  ## the SAME W^X seccomp hardening as systemcheck.service (keep the two property
  ## sets in sync; a dist-ai drift guard enforces it), so a manually started run
  ## is sandboxed like the autostart one. Best-effort: when no user service
  ## manager is reachable (root, or no login session) the run continues
  ## UNCONFINED rather than refuse to run -- the hardening self-check reports it.
  ## NoNewPrivileges is deliberately NOT applied (see systemcheck.service): under
  ## no_new_privs the kernel denies the AppArmor profile's helper transitions
  ## (man Px, pw-play Ux), so transition-based checks would false-fail.
  ## Skip when:
  ##  - SYSTEMCHECK_HARDENED=1 : this IS the re-exec'd confined run, or the
  ##                             autostart service (it sets the sentinel); loop guard.
  ##  - SYSTEMCHECK_CONFINE=0  : explicit opt-out.
  if [ "${SYSTEMCHECK_HARDENED:-}" = "1" ]; then
    return 0
  fi
  if [ "${SYSTEMCHECK_CONFINE:-1}" = "0" ]; then
    return 0
  fi
  if ! has systemd-run; then
    return 0
  fi
  ## Reachable user manager? (root or a sessionless environment has none.)
  if ! systemctl --user show-environment >/dev/null 2>&1; then
    return 0
  fi

  ## PTY only when ALL THREE std fds are terminals; otherwise --pipe, so a
  ## redirected stdin/stdout/stderr is honored (a --pty reconnects all three to
  ## the controlling terminal, dropping the redirection).
  local io_mode
  if [ -t 0 ] && [ -t 1 ] && [ -t 2 ]; then
    io_mode="--pty"
  else
    io_mode="--pipe"
  fi

  ## Forward the CALLER's environment: 'systemd-run --user' otherwise runs with
  ## the user manager's environment, which would drop caller vars and could let a
  ## manager-set var steer systemcheck. SYSTEMCHECK_HARDENED is appended last so
  ## it wins regardless of the caller's value.
  local -a setenv_args=()
  local env_entry
  while IFS= read -r -d '' env_entry; do
    setenv_args+=( "--setenv=${env_entry}" )
  done < <(env -0)

  ## style-ok: R-103  -- deliberate re-exec into the confined scope (the point).
  ## style-ok: R-170  -- NoExecPaths below is a systemd directive value that MUST
  ##                     match systemcheck.service literally, not a shell temp path.
  ## --expand-environment=no: the manager must NOT expand $VAR in the forwarded
  ## command arguments (they are the user's literal CLI args).
  exec systemd-run \
    --user \
    "${io_mode}" \
    --wait \
    --collect \
    --quiet \
    --expand-environment=no \
    "${setenv_args[@]}" \
    --property=MemoryDenyWriteExecute=true \
    --property=SystemCallArchitectures=native \
    --property=LockPersonality=true \
    --property="SystemCallFilter=~memfd_create" \
    --property=SystemCallErrorNumber=EPERM \
    --property="NoExecPaths=/tmp /var/tmp /dev/shm" \
    --setenv=SYSTEMCHECK_HARDENED=1 \
    -- /usr/bin/systemcheck "$@"
}

main() {
  set -o errexit
  set -o nounset
  set -o pipefail
  set -o errtrace
  shopt -s inherit_errexit
  shopt -s shift_verbose
  export LC_ALL=C

  ## Confine this run (W^X) unless already confined / no user manager; re-execs
  ## and does not return when it confines.
  systemcheck_confine_maybe "$@"

  #set -x

  ## Useful when xtrace ("set -x") is enabled and running in the background
  ## (such as if started as GUI from start menu) to log all xtrace to a log file.
  #[[ -v TMP ]] || TMP="/TMP"
  #safe-rm -f -- "/$TMP/systemcheck-debug.txt"
  #exec 5>&1 1>> "/$TMP/systemcheck-debug.txt"
  #exec 6>&2 2>> "/$TMP/systemcheck-debug.txt"

  ## Self-lock. Sourcing lockfile.sh re-execs this script under flock, so it must
  ## stay behind the was_executed guard -- a test sourcing the launcher must not
  ## acquire a lock or re-exec.
  # shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/lockfile.sh
  source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/lockfile.sh

  if [ -o xtrace ]; then
    ## NOTE: Not using 'bash -x' as this would disable AppArmor.
    ## XXX: Might add a superfluous ':xtrace'.
    env SHELLOPTS="${SHELLOPTS-}:xtrace" /usr/libexec/systemcheck/systemcheck "$@"
  else
    /usr/libexec/systemcheck/systemcheck "$@"
  fi
}

## Only auto-run when executed, not when sourced (unit tests source it).
if was_executed "${BASH_SOURCE[0]}"; then
  main "$@"
fi
