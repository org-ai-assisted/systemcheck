[Unit]
Description=System update checker (user service)
ConditionPathExists=!/usr/share/qubes/marker-vm

[Service]
Type=notify
ExecStart=/usr/libexec/systemcheck/updatecheck-daemon
## 7 hours.
WatchdogSec=25200
NotifyAccess=all
Restart=always

## W^X hardening (anonymous executable memory). MemoryDenyWriteExecute denies
## anon W+X and mprotect/shmat gaining PROT_EXEC; SystemCallArchitectures=native
## closes the secondary-ABI (i386) bypass; LockPersonality blocks the
## READ_IMPLIES_EXEC bypass; SystemCallFilter=~memfd_create kills the memfd
## bypass; NoExecPaths marks the shared writable dirs non-executable (file-backed
## exec MDWE does not cover). updatecheck-daemon is bash, no JIT.
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
LockPersonality=true
SystemCallFilter=~memfd_create
NoExecPaths=/tmp /var/tmp /dev/shm

## Defense-in-depth (separate axis from W^X): NoNewPrivileges blocks this
## daemon and its children from gaining privileges (setuid/setgid, file
## capabilities, AppArmor non-subset Px). Privileged work goes via leaprun,
## a non-setuid privleapd socket client, not in-process escalation.
NoNewPrivileges=yes
