## NOTE: Runs as user `systemcheck`. Can run privleap actions
## `read-journalctl-logs-this-boot`,
## `read-journalctl-logs-last-boot`, and
## `read-journalctl-logs-whonix-firewall`.

## provides was_executed. Source-able: functions are defined on source; the
## strict-mode and execution blocks auto-run ONLY when executed, so a unit test
## can source this file and call its functions without running it or inheriting
## strict-mode.
# shellcheck source=../../../../helper-scripts/usr/libexec/helper-scripts/check_runtime.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/check_runtime.bsh || true
if ! declare -F was_executed >/dev/null; then
   printf '%s\n' "$0: ERROR: cannot source check_runtime.bsh!" >&2
   exit 1
fi

# shellcheck source=../../../../helper-scripts/usr/libexec/helper-scripts/strings.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/strings.bsh

if was_executed "${BASH_SOURCE[0]}"; then
   set -o errexit
   set -o nounset
   set -o pipefail
   set -o errtrace
   shopt -s inherit_errexit
   shopt -s shift_verbose
   export LC_ALL=C
   ## Redirect all stderr to stdout.
   exec 2>&1
fi

## pipefail is on. A journal 'grep' legitimately exits non-zero when it matches
## nothing (e.g. a clean system), which must NOT abort the check, so each grep
## producer is wrapped in a brace group '{ grep ... || true; } | tee ...' (a
## group, not a subshell). Other producers are NOT masked: a leaprun journal-read
## failure or an stcatn format failure is a real error that SHOULD abort (the
## caller, check_services.bsh, already tolerates a non-zero log-checker).

## Copied from /usr/libexec/systemcheck/preparation.bsh.
source_config() {
   shopt -s nullglob
   local i file_perms
   for i in \
      /etc/systemcheck.d/*.conf \
      /usr/local/etc/systemcheck.d/*.conf \
      ; do
         file_perms="$(stat -c '%a' "${i}" 2>/dev/null)"
         if [[ "${file_perms}" == *[2367] ]]; then
            printf '%s\n' "${FUNCNAME[0]}: ERROR: Configuration file '${i}' is world-writable!"
            return 1;
         fi
         bash -n "${i}"
         # shellcheck disable=SC1090
         source "${i}"
   done
}

prep_temp_dir() {
  ## TMPDIR out of space
  TMPDIR='/var/cache/systemcheck-log-checker'
  TMP="${TMPDIR}"
  ## TEMP TEMPDIR set for consistency only.
  TEMP="${TMPDIR}"
  TEMPDIR="${TMPDIR}"
  export TMP TMPDIR TEMP TEMPDIR
  ## 'mkdir --mode' sets the mode only when CREATING; it does NOT re-apply to an
  ## already-existing dir. TMPDIR is a fixed path shared across the separate
  ## (privleap) log-checker invocations, so it cannot be a per-run mktemp dir.
  ## Therefore verify it is a real directory (not a symlink), owned by this user,
  ## mode 0700, and refuse otherwise: writing the journal into a pre-created
  ## world-readable or attacker-owned dir would leak its full contents.
  # shellcheck disable=SC2174
  mkdir --parents --mode=700 -- "${TMPDIR}"
  if test -h "${TMPDIR}" || ! test -d "${TMPDIR}" || ! test -O "${TMPDIR}" \
    || [ "$(stat -c '%a' -- "${TMPDIR}")" != '700' ]; then
    printf '%s\n' "$0: ${FUNCNAME[0]}: ERROR: Temporary directory '${TMPDIR}' is unsafe (must be a non-symlink directory, owned by this user, mode 0700)!"
    return 1
  fi
  test -w "${TMPDIR}"
}

check_service_logs() {
  local grep_ignore_fixed_items_command journal_ignore_fixed_item grep_ignore_patterns_command journal_ignore_pattern_item journal_search_pattern_list check_boot

  check_boot="${1:-}"

  safe-rm --force -- "${TMPDIR}/journalctl_output.txt"
  touch -- "${TMPDIR}/journalctl_output.txt"

  ## A failed journal read aborts (pipefail); leaprun's stderr is folded into the
  ## captured output (2>&1) so it is inspected too.
  if [ "${check_boot}" = 'this_boot' ]; then
    leaprun read-journalctl-logs-this-boot 2>&1 | tee --append -- "${TMPDIR}/journalctl_output.txt" >/dev/null
  elif [ "${check_boot}" = 'last_boot' ]; then
    leaprun read-journalctl-logs-last-boot 2>&1 | tee --append -- "${TMPDIR}/journalctl_output.txt" >/dev/null
  else
    printf '%s\n' "$0: ${FUNCNAME[0]}: ERROR: Unrecognized boot identifier '${check_boot}', expected 'this_boot' or 'last_boot'!"
    return 1
  fi

  ## 'BUG' is word-boundary anchored (like 'fault' below) so it matches real
  ## kernel reports ('BUG:', 'kernel BUG at') but NOT the substring in words like
  ## 'debugging'.
  journal_search_pattern_list="SECCOMP.*syscall=|warn|fail|error|ordering cycle|(^|[^a-zA-Z])BUG($|[^a-zA-Z])|segfault|killed|(^|[^a-zA-Z])fault($|[^a-zA-Z])|self-detected stall on CPU"

  if test -e /usr/share/qubes/marker-vm; then
    journal_ignore_patterns_list+=( "virtualbox" )
  fi

  { grep --extended-regexp --ignore-case "${journal_search_pattern_list}" -- "${TMPDIR}/journalctl_output.txt" || true; } \
    | tee -- "${TMPDIR}/journalctl_matched.txt" >/dev/null

  safe-rm --force -- "${TMPDIR}/journalctl_output.txt"

  ## Output by 'apparmor-info' is already de-duplicated.
  leaprun read-apparmor-info | tee --append -- "${TMPDIR}/journalctl_matched.txt" >/dev/null

  ## No fixed ignore strings -> filter NOTHING: 'grep --fixed-strings' with no
  ## '-e' pattern treats the file path as the pattern (no file operand) and then
  ## blocks reading stdin. An empty ignore list legitimately means "ignore nothing".
  if [ "${#journal_ignore_fixed_list[@]}" -gt 0 ]; then
    grep_ignore_fixed_items_command=( grep --invert-match --fixed-strings --ignore-case )
    for journal_ignore_fixed_item in "${journal_ignore_fixed_list[@]}"; do
      grep_ignore_fixed_items_command+=( -e "${journal_ignore_fixed_item}" )
    done
    { "${grep_ignore_fixed_items_command[@]}" -- "${TMPDIR}/journalctl_matched.txt" || true; } \
      | tee -- "${TMPDIR}/journalctl_fixed_filtered.txt" >/dev/null
  else
    cp -- "${TMPDIR}/journalctl_matched.txt" "${TMPDIR}/journalctl_fixed_filtered.txt"
  fi

  safe-rm --force -- "${TMPDIR}/journalctl_matched.txt"

  ## No ignore patterns -> filter NOTHING: a grep with no -e pattern (or an empty
  ## one) would drop ALL lines and the check would report clean having inspected
  ## nothing. Each pattern is passed as its own -e (an extended regexp), which ORs
  ## them exactly like the old '|'-join but needs no command substitution.
  if [ "${#journal_ignore_patterns_list[@]}" -gt 0 ]; then
    grep_ignore_patterns_command=( grep --invert-match --extended-regexp --ignore-case )
    for journal_ignore_pattern_item in "${journal_ignore_patterns_list[@]}"; do
      grep_ignore_patterns_command+=( -e "${journal_ignore_pattern_item}" )
    done
    { "${grep_ignore_patterns_command[@]}" -- "${TMPDIR}/journalctl_fixed_filtered.txt" || true; } \
      | tee -- "${TMPDIR}/journalctl_match_filtered.txt" >/dev/null
  else
    cp -- "${TMPDIR}/journalctl_fixed_filtered.txt" "${TMPDIR}/journalctl_match_filtered.txt"
  fi

  ## Neutralize HTML metacharacters in untrusted journal content BEFORE
  ## br_add_to_file bakes in '<br />' tags. This output is later rendered in
  ## the GUI; stcatn (applied afterwards) strips ANSI, not HTML.
  ##
  ## Redirect form (not a 'sponge' pipe) so a sanitize-string failure DOES abort
  ## the script here (it is a single command under errexit), rather than being a
  ## masked producer like the tolerant journal greps above.
  sanitize-string -- nolimit < "${TMPDIR}/journalctl_match_filtered.txt" > "${TMPDIR}/journalctl_match_filtered.txt.tmp"
  mv -- "${TMPDIR}/journalctl_match_filtered.txt.tmp" "${TMPDIR}/journalctl_match_filtered.txt"

  ## Creates file: '$TMPDIR/journalctl_match_filtered.txt_br'
  br_add_to_file "${TMPDIR}/journalctl_match_filtered.txt"

  safe-rm --force -- "${TMPDIR}/journalctl_match_filtered.txt"

  stcatn "${TMPDIR}/journalctl_match_filtered.txt_br" | sort --unique
}

check_critical_logs() {
   local hard_critical kernel_ident file

   file="${TMPDIR}/journalctl_match_filtered.txt_br"
   if ! test -e "${file}"; then
      return 0
   fi

   ## Kernel-catastrophe tokens that are ALWAYS critical ("so bad they must be shown").
   hard_critical='Bad RAM detected|self-detected stall on CPU|nouveau .* channel .* killed!'
   ## ' BUG:' (a kernel BUG:/oops; the leading space avoids 'debug:') is force-shown ONLY on
   ## lines that also carry the ' kernel:' syslog identifier (parse_cmd's readers run
   ## 'journalctl --output short', which prints '<host> kernel:' for kernel messages). Tor's
   ## userspace 'Bug:' lines -- tor_bug_occurred_() non-fatal asserts, tor_assertion_failed_()
   ## aborts, and log_backtrace() frames alike -- are NOT kernel catastrophes; Tor logs them
   ## mixed-case 'Bug:' with no stable backtrace signature, so there is no robust content
   ## filter. They are surfaced by the service-log check, not this always-shown tier.
   ## This cannot HIDE a real kernel BUG: a genuine kernel line always carries ' kernel:'.
   ## SCOPE: ' kernel:' is a substring test, not a positional field anchor, so a local
   ## process that logs 'kernel:' next to 'BUG:' in its OWN message can raise a FALSE-positive
   ## critical -- the same forgeability class as the prior ' BUG:'-anywhere match, and
   ## strictly rarer. A capture-time _TRANSPORT=kernel / --dmesg anchor in parse_cmd is the
   ## robust follow-up.
   kernel_ident=' kernel:'

   ## '|| true' keeps a no-match grep from tripping errexit; 'sort --unique' drops the
   ## overlap when a line matches both arms.
   {
      grep --ignore-case --extended-regexp -- "${hard_critical}" "${file}" || true
      grep --ignore-case --fixed-strings -- ' BUG:' "${file}" \
        | grep --fixed-strings -- "${kernel_ident}" || true
   } | sort --unique | stcatn

   safe-rm --force -- "${file}"
}

main() {
  local check_mode
  journal_ignore_patterns_list=()
  journal_ignore_fixed_list=()
  source_config
  prep_temp_dir

  check_mode="${1:-}"
  if [ "${check_mode}" = 'check_service_logs' ]; then
    check_service_logs "${2:-}"
  elif [ "${check_mode}" = 'check_critical_logs' ]; then
    check_critical_logs
  else
    printf '%s\n' "$0: ERROR: Unrecognized mode '${check_mode}' specified!" >&2
    return 1
  fi
}

if was_executed "${BASH_SOURCE[0]}"; then
  main "$@"
fi
