# shellcheck disable=SC2154  ## globals set by the sourcing 'systemcheck' orchestrator

## style-ok: no-strict
## Sourced fragment; 'systemcheck' owns the strict-mode preamble.

check_audio() {
   ## Don't play audible sounds unless the user asks for verbose output.
   ##
   ## TODO: Playing an audible sound may be a security hazard for some users,
   ## even if `--verbose` is passed. Gate this test behind a `--test-audio`
   ## option.
   if [ "${verbose}" -lt "1" ]; then
      return 0
   fi

   local audio_file
   ## TODO: White noise is confusing, the user may think their speakers are
   ## broken because the sound doesn't sound recognizable. complete.oga (a bell
   ## ringing sound) might be better?
   audio_file="/usr/share/sounds/freedesktop/stereo/audio-test-signal.oga"

   if ! has pw-play >/dev/null ; then
      local MSG="<p>Audio Test: Skipped. <code>pw-play</code> (PipeWire) is not installed.</p>"
      emit_message info "${MSG}"
      return 0
   fi

   if [ ! -r "${audio_file}" ]; then
      local MSG="<p>Audio Test: Skipped. Test sound file <code>${audio_file}</code> is missing. It is normally provided by <code>sound-theme-freedesktop</code> (a dependency).</p>"
      emit_message info "${MSG}"
      return 0
   fi

   ## Bound the playback so a stuck audio backend cannot stall systemcheck.
   local pw_play_exit_code
   pw_play_exit_code="0"
   timeout --kill-after="5" "10" pw-play -- "${audio_file}" >/dev/null 2>&1 \
      || pw_play_exit_code="$?"

   if [ "${pw_play_exit_code}" = "0" ]; then
      local MSG="<p>Audio Test: A short test sound was played via <code>pw-play</code>. ${status_ok} If you did not hear it, audio output may not be working.</p>"
      emit_message info "${MSG}"
   else
      ## Audio output is not a system-integrity property, so we don't set
      ## EXIT_CODE.
      local MSG="<p>Audio Test: <code>pw-play</code> could not play the test sound (exit code: <code>${pw_play_exit_code}</code>). Audio output may not be working.</p>"
      emit_message warning "${MSG}"
   fi
}
