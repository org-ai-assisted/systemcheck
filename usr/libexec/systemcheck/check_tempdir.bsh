#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## Globals are set and consumed by 'systemcheck'.
# shellcheck disable=SC2154,SC2034

## style-ok: no-strict
## Sourced fragment; 'systemcheck' owns the strict-mode preamble.
## style-ok: no-tmp-hardcode - this code checks the value of $TMP-family vars.

## TODO: Should we always run all checks rather than returning as soon as one
## fails?

check_tempdir() {
   local id_of_user tmpdir_base tmpdir_base_parent tmpdir_expected var bad_vars status_text
   status_text="Temporary Directory Test Result"
   id_of_user="$(id --user)"
   tmpdir_base="/tmp/user"
   tmpdir_base_parent="${tmpdir_base%/*}"
   tmpdir_expected="${tmpdir_base}/${id_of_user}"

   ## Check that each $TMP-family var is set to the expected value. An attacker
   ## could place malicious characters into these vars, so we print the var
   ## names only.
   bad_vars=""
   for var in TMPDIR TMP TEMP TEMPDIR; do
      if [ ! "${!var-}" = "${tmpdir_expected}" ]; then
         bad_vars="${bad_vars:+"${bad_vars}, "}${var}"
      fi
   done
   if [ -n "${bad_vars}" ]; then
      emit_status_line warning "${status_text}" "" orange "Wrong" \
         "Some temp dir variables are not set to <code>${tmpdir_expected}</code> but should be: ${bad_vars}"
      EXIT_CODE="1"
      return 0
   fi

   ## Check that the base tempdir base is the right kind of object and has
   ## proper ownership and permissions. ${tmpdir_base} must be exactly mode 711
   ## or the system will break or be insecure. In particular, a mode of 700 is
   ## not permissible as it will break temp dirs for everyone.
   ## The PARENT of ${tmpdir_base} (/tmp) must be root-owned and sticky (1777). If the
   ## sticky bit is dropped (e.g. chmod 0777 /tmp), another unprivileged user can rename
   ## ${tmpdir_base} and replace the whole hierarchy, defeating the per-user checks below.
   if test -L "${tmpdir_base_parent}" || ! test -d "${tmpdir_base_parent}" \
      || ! [ "$(stat --format='%u' -- "${tmpdir_base_parent}")" = '0' ] \
      || ! [ "$(stat --format='%a' -- "${tmpdir_base_parent}")" = '1777' ]; then
      emit_status_line warning "${status_text}" "" orange "Unsafe" \
         "The parent temp directory <code>${tmpdir_base_parent}</code> must be a non-symlink directory owned by <code>root</code> and sticky, with permissions set to <code>1777</code>."
      EXIT_CODE="1"
      return 0
   fi

   if test -L "${tmpdir_base}" || ! test -d "${tmpdir_base}" \
      || ! [ "$(stat --format='%u' -- "${tmpdir_base}")" = '0' ] \
      || ! [ "$(stat --format='%a' -- "${tmpdir_base}")" = '711' ]; then
      emit_status_line warning "${status_text}" "" orange "Unsafe" \
         "The temp base directory <code>${tmpdir_base}</code> must be a non-symlink directory owned by <code>root</code> and with permissions set to <code>711</code>."
      EXIT_CODE="1"
      return 0
   fi

   if test -L "${tmpdir_expected}" || ! test -d "${tmpdir_expected}" \
      || ! test -O "${tmpdir_expected}" \
      || ! [ "$(stat --format='%a' -- "${tmpdir_expected}")" = '700' ]; then
      emit_status_line warning "${status_text}" "" orange "Unsafe" \
         "<code>${tmpdir_expected}</code> must be a non-symlink directory owned by this account with permissions set to <code>700</code>."
      EXIT_CODE="1"
      return 0
   fi

   run_if_verbose emit_status_line info "${status_text}" "" green "${status_ok}"
   return 0
}
