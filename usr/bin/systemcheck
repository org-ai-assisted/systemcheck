#!/bin/bash

## Copyright (C) 2012 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.
## style-ok: no-strict
## Explicit strict options set; global 'export LC_ALL=C' omitted by design (locale forced per-command).

#set -x
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

## Useful when xtrace ("set -x") is enabled and running in the background
## (such as if started as GUI from start menu) to log all xtrace to a log file.
#[[ -v TMP ]] || TMP="/TMP"
#safe-rm -f -- "/$TMP/systemcheck-debug.txt"
#exec 5>&1 1>> "/$TMP/systemcheck-debug.txt"
#exec 6>&2 2>> "/$TMP/systemcheck-debug.txt"

## Self-lock: serialize whole systemcheck runs per user so concurrent invocations
## cannot race on the shared log-checker TMPDIR. MUST stay the first executable
## statement: lockfile.sh re-execs this script under flock, so any code above it
## runs twice (the set-options above are idempotent, so that is harmless). A second
## concurrent run exits 75 (EX_TEMPFAIL) with an "already running" message.
source /usr/libexec/helper-scripts/lockfile.sh

if [ -o xtrace ]; then
  ## NOTE: Not using 'bash -x' as this would disable AppArmor.
  ## XXX: Might add a superfluous ':xtrace'.
  env SHELLOPTS="${SHELLOPTS-}:xtrace" /usr/libexec/systemcheck/systemcheck "$@"
else
  /usr/libexec/systemcheck/systemcheck "$@"
fi
