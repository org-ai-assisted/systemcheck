# Read a JSON object from stdin and print the value of the top-level field
# named in argv[1]. A missing key or malformed JSON raises and exits non-zero,
# matching the previous inline 'python3 -c' behavior the callers rely on.

import sys
import json

print(json.load(sys.stdin)[sys.argv[1]])
