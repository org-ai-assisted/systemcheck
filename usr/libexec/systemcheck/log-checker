## NOTE: Runs as user `systemcheck`. Can run privleap actions
## `read-journalctl-logs-this-boot`,
## `read-journalctl-logs-last-boot`, and
## `read-journalctl-logs-whonix-firewall`.

## provides was_executed
# shellcheck source=../../../../helper-scripts/usr/libexec/helper-scripts/check_runtime.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/check_runtime.bsh || true
if ! declare -F was_executed >/dev/null; then
   printf '%s\n' "$0: ERROR: cannot source check_runtime.bsh!" >&2
   exit 1
fi

# shellcheck source=../../../../helper-scripts/usr/libexec/helper-scripts/strings.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/strings.bsh

if was_executed "${BASH_SOURCE[0]}"; then
   set -o errexit
   set -o nounset
   set -o pipefail
   set -o errtrace
   shopt -s inherit_errexit
   shopt -s shift_verbose
   export LC_ALL=C
   ## Redirect all stderr to stdout.
   exec 2>&1
fi

## Copied from /usr/libexec/systemcheck/preparation.bsh.
source_config() {
   shopt -s nullglob
   local i file_perms
   for i in \
      /etc/systemcheck.d/*.conf \
      /usr/local/etc/systemcheck.d/*.conf \
      ; do
         file_perms="$(stat -c '%a' "${i}" 2>/dev/null)"
         if [[ "${file_perms}" == *[2367] ]]; then
            printf '%s\n' "${FUNCNAME[0]}: ERROR: Configuration file '${i}' is world-writable!"
            return 1;
         fi
         bash -n "${i}"
         # shellcheck disable=SC1090
         source "${i}"
   done
}

prep_temp_dir() {
  ## TMPDIR out of space
  TMPDIR='/var/cache/systemcheck-log-checker'
  TMP="${TMPDIR}"
  ## TEMP TEMPDIR set for consistency only.
  TEMP="${TMPDIR}"
  TEMPDIR="${TMPDIR}"
  export TMP TMPDIR TEMP TEMPDIR
  ## The directory creation and permission assignment must be done atomically,
  ## otherwise a TOCTOU vuln may allow arbitrary processes to leak the full
  ## contents of the journal.
  # shellcheck disable=SC2174
  mkdir --parents --mode=700 -- "${TMPDIR}"
  ## The dir may already exist, so make sure it is a non-symlink dir and its
  ## permissions and ownership are safe.
  if test -L "${TMPDIR}" || ! test -d "${TMPDIR}" || ! test -O "${TMPDIR}" \
    || [ "$(stat --format='%a' -- "${TMPDIR}")" != '700' ]; then
    printf '%s\n' "$0: ${FUNCNAME[0]}: ERROR: Temporary directory '${TMPDIR}' is unsafe!"
    return 1
  fi
  test -w "${TMPDIR}"
}

check_service_logs() {
  local grep_ignore_fixed_items_command journal_ignore_fixed_item grep_ignore_patterns_command journal_ignore_pattern_item journal_search_pattern_list check_boot

  check_boot="${1:-}"

  safe-rm --force -- "${TMPDIR}/journalctl_kernel.txt"
  safe-rm --force -- "${TMPDIR}/journalctl_output.txt"
  touch -- "${TMPDIR}/journalctl_output.txt"

  if [ "${check_boot}" = 'this_boot' ]; then
    leaprun read-journalctl-logs-this-boot 2>&1 | tee --append -- "${TMPDIR}/journalctl_output.txt" >/dev/null
  elif [ "${check_boot}" = 'last_boot' ]; then
    ## Absent last boot logs must not be permitted to cause script failure, as
    ## this would break systemcheck under Qubes OS.
    { leaprun read-journalctl-logs-last-boot || true; } 2>&1 | tee --append -- "${TMPDIR}/journalctl_output.txt" >/dev/null
  else
    printf '%s\n' "$0: ${FUNCNAME[0]}: ERROR: Unrecognized boot identifier '${check_boot}', expected 'this_boot' or 'last_boot'!"
    return 1
  fi

  journal_search_pattern_list="SECCOMP.*syscall=|warn|fail|error|ordering cycle|(^|[^a-zA-Z])BUG($|[^a-zA-Z])|segfault|killed|(^|[^a-zA-Z])fault($|[^a-zA-Z])|self-detected stall on CPU"

  if test -e /usr/share/qubes/marker-vm; then
    journal_ignore_patterns_list+=( "virtualbox" )
  fi

  { grep --extended-regexp --ignore-case "${journal_search_pattern_list}" -- "${TMPDIR}/journalctl_output.txt" || true; } \
    | tee -- "${TMPDIR}/journalctl_matched.txt" >/dev/null

  safe-rm --force -- "${TMPDIR}/journalctl_output.txt"

  ## Output by 'apparmor-info' is already de-duplicated.
  ##
  ## Need to silence non-zero exit code from apparmor-info, as it returns 1
  ## when "DENIED" messages are found.
  { leaprun read-apparmor-info || true; } | tee --append -- "${TMPDIR}/journalctl_matched.txt" >/dev/null

  if [ "${#journal_ignore_fixed_list[@]}" -gt 0 ]; then
    grep_ignore_fixed_items_command=( grep --invert-match --fixed-strings --ignore-case )
    for journal_ignore_fixed_item in "${journal_ignore_fixed_list[@]}"; do
      grep_ignore_fixed_items_command+=( -e "${journal_ignore_fixed_item}" )
    done
    { "${grep_ignore_fixed_items_command[@]}" -- "${TMPDIR}/journalctl_matched.txt" || true; } \
      | tee -- "${TMPDIR}/journalctl_fixed_filtered.txt" >/dev/null
  else
    cp -- "${TMPDIR}/journalctl_matched.txt" "${TMPDIR}/journalctl_fixed_filtered.txt"
  fi

  safe-rm --force -- "${TMPDIR}/journalctl_matched.txt"

  if [ "${#journal_ignore_patterns_list[@]}" -gt 0 ]; then
    grep_ignore_patterns_command=( grep --invert-match --extended-regexp --ignore-case )
    for journal_ignore_pattern_item in "${journal_ignore_patterns_list[@]}"; do
      grep_ignore_patterns_command+=( -e "${journal_ignore_pattern_item}" )
    done
    { "${grep_ignore_patterns_command[@]}" -- "${TMPDIR}/journalctl_fixed_filtered.txt" || true; } \
      | tee -- "${TMPDIR}/journalctl_match_filtered.txt" >/dev/null
  else
    cp -- "${TMPDIR}/journalctl_fixed_filtered.txt" "${TMPDIR}/journalctl_match_filtered.txt"
  fi

  ## Neutralize HTML metacharacters in untrusted journal content BEFORE
  ## br_add_to_file bakes in '<br />' tags. This output is later rendered in
  ## the GUI; stcatn (applied afterwards) strips ANSI, not HTML.
  sanitize-string -- nolimit < "${TMPDIR}/journalctl_match_filtered.txt" > "${TMPDIR}/journalctl_match_filtered.txt.tmp"
  mv -- "${TMPDIR}/journalctl_match_filtered.txt.tmp" "${TMPDIR}/journalctl_match_filtered.txt"

  ## Creates file: '$TMPDIR/journalctl_match_filtered.txt_br'
  br_add_to_file "${TMPDIR}/journalctl_match_filtered.txt"

  safe-rm --force -- "${TMPDIR}/journalctl_match_filtered.txt"

  stcatn "${TMPDIR}/journalctl_match_filtered.txt_br" | sort --unique
  safe-rm --force -- "${TMPDIR}/journalctl_match_filtered.txt_br"

  ## These will later be used by check_critical_logs. Note that these are
  ## intentionally unsanitized for now and will be sanitized later.
  if [ "${check_boot}" = 'this_boot' ]; then
    leaprun read-journalctl-kernel-logs-this-boot 2>&1 | tee -- "${TMPDIR}/journalctl_kernel.txt" >/dev/null
  else
    { leaprun read-journalctl-kernel-logs-last-boot || true; } 2>&1 | tee -- "${TMPDIR}/journalctl_kernel.txt" >/dev/null
  fi
}

check_critical_logs() {
   local hard_critical log_file matched

   log_file="${TMPDIR}/journalctl_kernel.txt"
   if ! test -e "${log_file}"; then
      return 0
   fi

   hard_critical='Bad RAM detected|self-detected stall on CPU| BUG:|^BUG:|BUG at |BUG at:|nouveau .* channel .* killed!'
   matched="${TMPDIR}/journalctl_kernel_critical.txt"
   ## Technically sanitize-string could drop text it doesn't need to if a
   ## critical line of a kernel log contains '<' and '>' characters, but this
   ## is very unlikely to happen, and the kinds of logs we search for are
   ## unlikely to be ones an attacker can influence.
   { grep --text --ignore-case --extended-regexp -- "${hard_critical}" "${log_file}" || true; } | sort --unique | sanitize-string --no-block -- nolimit > "${matched}"

   br_add_to_file "${matched}"
   stcatn "${matched}_br"

   safe-rm --force -- "${log_file}" "${matched}" "${matched}_br"
}

main() {
  local check_mode
  journal_ignore_patterns_list=()
  journal_ignore_fixed_list=()
  source_config
  prep_temp_dir

  check_mode="${1:-}"
  if [ "${check_mode}" = 'check_service_logs' ]; then
    check_service_logs "${2:-}"
  elif [ "${check_mode}" = 'check_critical_logs' ]; then
    check_critical_logs
  elif [ "${check_mode}" = 'get_failed_load_modules_list' ]; then
    ( leaprun read-journalctl-logs-this-boot || true ) 2>&1 \
      | sed -n "s/.*Failed to insert module '\(.*\)':.*/\1/p" \
      | sanitize-string -- nolimit
  elif [ "${check_mode}" = 'get_kernel_module_key_rejected_count' ]; then
    ( leaprun read-journalctl-logs-this-boot || true ) 2>&1 \
      | grep --fixed-strings --count 'kernel: Loading of module with unavailable key is rejected'
  else
    printf '%s\n' "$0: ERROR: Unrecognized mode '${check_mode}' specified!" >&2
    return 1
  fi
}

if was_executed "${BASH_SOURCE[0]}"; then
  main "$@"
fi
