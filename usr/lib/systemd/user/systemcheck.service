[Unit]
Description=System health checker (user service)

[Service]
Type=exec
ExecStart=systemcheck --autostart
RemainAfterExit=true

## W^X hardening (anonymous executable memory). MemoryDenyWriteExecute denies
## anon W+X and mprotect/shmat gaining PROT_EXEC; SystemCallArchitectures=native
## closes the secondary-ABI (i386) bypass; LockPersonality blocks the
## READ_IMPLIES_EXEC bypass; SystemCallFilter=~memfd_create denies the memfd
## bypass; NoExecPaths marks the shared writable dirs non-executable (file-backed
## exec MDWE does not cover). The bash front-end does not JIT.
## SystemCallErrorNumber=EPERM: a denied syscall returns -EPERM (a catchable
## error) instead of the default SIGSYS kill. These restrictions INHERIT into
## children; the progress-bar path (msgcollector -> msgprogressbar -> yad, GTK)
## runs as a DIRECT descendant here and calls memfd_create for its shm buffer --
## EPERM lets GTK fall back and render, where a SIGSYS kill would abort it. (The
## --messagex/passive dialogs render out-of-process in msgdispatcher, so those
## are not under this filter.)
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
LockPersonality=true
SystemCallFilter=~memfd_create
SystemCallErrorNumber=EPERM
NoExecPaths=/tmp /var/tmp /dev/shm
